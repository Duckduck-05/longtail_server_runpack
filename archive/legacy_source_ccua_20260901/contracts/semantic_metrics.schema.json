{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic terminal-allocation metrics",
  "type": "object",
  "required": [
    "js", "rare_mode_mass", "coarse_consistency", "memorization",
    "num_generated", "evaluator_fingerprint", "bootstrap_draws_file", "generation"
  ],
  "properties": {
    "js": {"type": "number", "minimum": 0},
    "rare_mode_mass": {"type": "number", "minimum": 0, "maximum": 1},
    "coarse_consistency": {"type": "number", "minimum": 0, "maximum": 1},
    "memorization": {"type": "number"},
    "num_generated": {"type": "integer", "minimum": 1},
    "evaluator_fingerprint": {"type": "string", "minLength": 1},
    "target_distribution": {"type": "array", "items": {"type": "number"}},
    "generated_distribution": {"type": "array", "items": {"type": "number"}},
    "per_class": {"type": "object"},
    "bootstrap_draws_file": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "required": ["FID", "KID", "Recall"],
      "properties": {
        "FID": {"type": "number", "minimum": 0},
        "KID": {"type": "number"},
        "Recall": {"type": "number", "minimum": 0, "maximum": 1},
        "Precision": {"type": "number", "minimum": 0, "maximum": 1},
        "IS": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "safety": {"type": "object"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
