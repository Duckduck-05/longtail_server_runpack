{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen semantic weight manifest",
  "type": "object",
  "required": [
    "dataset_name",
    "dataset_fingerprint",
    "sample_ids_sha256",
    "num_samples",
    "weights_file",
    "weights_sha256",
    "method",
    "normalization"
  ],
  "properties": {
    "dataset_name": {
      "type": "string"
    },
    "dataset_fingerprint": {
      "type": "string"
    },
    "sample_ids_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "num_samples": {
      "type": "integer",
      "minimum": 1
    },
    "weights_file": {
      "type": "string"
    },
    "weights_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "method": {
      "type": "string",
      "enum": [
        "oracle",
        "predictive",
        "pointfit",
        "permutation",
        "random_group",
        "inverse_class_frequency",
        "uniform_manifest",
        "sqrt_inverse_class_frequency"
      ]
    },
    "normalization": {
      "type": "string",
      "enum": [
        "mean_one",
        "sum_one_global",
        "sum_one_per_class",
        "sampling_probability"
      ]
    },
    "effective_sample_size": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "estimator_commit": {
      "type": "string"
    },
    "representation": {
      "type": "string"
    },
    "K": {
      "type": "integer",
      "minimum": 1
    },
    "alpha": {
      "type": "number"
    },
    "fine_labels_used_for_training": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
