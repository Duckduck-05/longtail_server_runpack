# W&B. Prefer this file over hardcoding a secret in source code.
# Save this as .env.local next to this independent runpack.  It is ignored and
# never copied into source control. An explicit LTX_ENV_FILE is also supported.
WANDB_API_KEY=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
WANDB_ENTITY=
WANDB_PROJECT=longtail
WANDB_MODE=online
WANDB_DIR=./wandb
WANDB_SILENT=true

# Optional notification behavior.
LTX_WANDB_ALERTS=critical

# Runtime roots. Relative paths are resolved from this repository.
LTX_REPOS_ROOT=./third_party
LTX_RUNS_ROOT=./runs
LTX_DATA_ROOT=./data
LTX_METRICS_ROOT=./third_party/CBDM-pytorch/stats

# Licensed ImageNet-LT inputs (the runner validates them; it cannot legally
# download ImageNet without the account/license held by the receiving server).
LTX_IMAGENET_ROOT=
LTX_IMAGENET_LT_TRAIN_MANIFEST=
LTX_IMAGENET_LT_REFERENCE_MANIFEST=

# Paper-comparison guard. This does not create a method; it names an already
# configured task method (for example `ours`) so reports can compute paired
# seed advantages and CIs. Leave empty for a baseline-only reproduction.
LTX_CANDIDATE_METHOD=
LTX_REQUIRE_CANDIDATE_FOR_PAPER_CLAIM=false

# Optional path to an existing untracked environment file.
LTX_ENV_FILE=

# Critical frozen project artifacts. These must match the locked experiment.
LTX_SEMANTIC_MANIFEST=
LTX_WEIGHT_ORACLE=
LTX_WEIGHT_PREDICTIVE=
LTX_WEIGHT_POINTFIT=
LTX_WEIGHT_PERMUTATION=
LTX_WEIGHT_RANDOM_GROUP=

# A command template that writes semantic_metrics.json.
# Available placeholders: {samples}, {labels}, {run_dir}, {output}, {manifest}, {method}, {seed}
LTX_SEMANTIC_EVAL_COMMAND=
